[Unit]
Description=zovex-server-next — שרת /stream ב-Go (gotd/td)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/root/zovex-server-next
ExecStart=/root/zovex-server-next/zovex-server-next
# את הטוקנים והסודות קוראים מקובץ, לא כותבים כאן — הקובץ הזה נמצא בגיט.
# EnvironmentFile חייב להכיל: API_ID · API_HASH · BOT_TOKENS ·
# STREAM_CHANNEL_ID · STREAM_CHANNEL_ACCESS_HASHES · STREAM_SIGN_SECRET
# STREAM_SIGN_SECRET חייב להיות **זהה** ל-SIGN_SECRET שב-/opt/zovex-bot/.env,
# אחרת כל הקישורים החתומים שבקטלוג ייכשלו באימות.
EnvironmentFile=/root/zovex-server-next/.env
Environment=LISTEN_ADDR=:8098

Restart=always
RestartSec=5
# סרט שלם דרך חיבור אחד לוקח שעה ויותר. 30 שניות לסגירה מסודרת מספיקות
# כדי לשחרר את החיבורים; מה שנשאר ייקטע, וזה בסדר — הנגן מבקש שוב.
TimeoutStopSec=30
KillSignal=SIGTERM

# הגבלת מתארי קבצים: כל בוט וכל סטרים פעיל תופסים סוקטים. ברירת המחדל
# של systemd (1024) נמוכה מדי לעשרות צופים במקביל.
LimitNOFILE=65535

[Install]
WantedBy=multi-user.target
