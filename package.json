{
  "name": "zovex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-sitemap.js",
    "build": "vite build",
    "build:vps": "SITE_URL=https://zovex.duckdns.org node scripts/generate-sitemap.js && vite build --base=/ && SITE_URL=https://zovex.duckdns.org node scripts/prerender-routes.js && sed -i 's#https://davidggjg.github.io/zovex#https://zovex.duckdns.org#g' dist/robots.txt",
    "postbuild": "node scripts/prerender-routes.js",
    "preview": "vite preview",
    "scan": "node scripts/scan.js",
    "scan:fix": "node scripts/scan.js --fix"
  },
  "dependencies": {
    "lucide-react": "^0.383.0",
    "plyr": "^3.8.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "vite": "^5.4.0"
  }
}
